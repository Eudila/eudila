# Next.js en modo standalone: solo lo necesario para correr (la compilación ocurre antes, en up.sh).
FROM node:24-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY standalone ./
COPY static ./.next/static
COPY public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
