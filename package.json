{
  "name": "eudila",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @eudila/app --",
    "build": "npm run build --workspace @eudila/app",
    "start": "npm run start --workspace @eudila/app --",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspace @eudila/app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "node app/infra/scripts/local-auth.mjs",
    "supabase:stop": "supabase --workdir app stop",
    "test:auth": "uv run --with playwright python app/app/auth/browser.test.py",
    "test": "node --test \"packages/**/*.test.mjs\" \"app/**/*.test.mjs\" \"landing/**/*.test.mjs\"",
    "build:landing": "npm run build --workspace @eudila/landing",
    "sync:assets": "node app/infra/scripts/sync-assets.mjs",
    "pretest": "npm run sync:assets"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.6",
    "prettier": "3.9.9",
    "supabase": "^2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "app",
    "landing",
    "packages/*"
  ]
}
