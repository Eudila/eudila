# ANI-64: origen del proyecto Supabase, sin /rest/v1 ni el nombre de tabla.
# Local: http://127.0.0.1:54321. Cloud: https://<project-ref>.supabase.co
NEXT_PUBLIC_CATALOG_URL=
# Clave pública anon (JWT). Nunca usar service_role ni una clave secreta.
NEXT_PUBLIC_CATALOG_ANON_KEY=

# Vista previa: catálogo local y registros guardados solo en esta pestaña.
# Usar false al conectar la base de datos real; nunca hay fallback a datos de ejemplo.
NEXT_PUBLIC_FRONTEND_PREVIEW=true
